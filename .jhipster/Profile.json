{
  "annotations": {
    "changelogDate": "20231211193718"
  },
  "applications": ["hcAdmin"],
  "clientRootFolder": "directory",
  "documentation": "The shared person record behind both patients and professionals.\\n\\n`accountId` is the identity link to the gateway's Account. It is a plain\\nString, not a relationship: Account lives in hc-admin-gateway's own\\ndatabase and this service cannot join across that boundary — the gateway\\nmints the id and puts it on the JWT so the api can stamp the right one.\\nA Profile with no accountId is a person no login can reach, so it is\\nrequired.",
  "fields": [
    {
      "fieldName": "id",
      "fieldType": "String"
    },
    {
      "fieldName": "accountId",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "60"
    },
    {
      "fieldName": "title",
      "fieldType": "Title",
      "fieldValues": "MR,MRS,MS,DR,PROF"
    },
    {
      "fieldName": "firstName",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "middleName",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "lastName",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "dateOfBirth",
      "fieldType": "LocalDate",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "sex",
      "fieldType": "Sex",
      "fieldValidateRules": ["required"],
      "fieldValues": "MALE,FEMALE"
    },
    {
      "fieldName": "mobilePhone",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "24"
    },
    {
      "fieldName": "email",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "120",
      "fieldValidateRulesPattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    {
      "fieldName": "idType",
      "fieldType": "IdType",
      "fieldValidateRules": ["required"],
      "fieldValues": "GHANA_CARD,PASSPORT,VOTER_ID,DRIVERS_LICENCE"
    },
    {
      "fieldName": "idNumber",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "40"
    }
  ],
  "name": "Profile",
  "relationships": [
    {
      "otherEntityName": "address",
      "otherEntityRelationshipName": "profile",
      "relationshipName": "address",
      "relationshipSide": "left",
      "relationshipType": "one-to-one"
    },
    {
      "otherEntityName": "patient",
      "otherEntityRelationshipName": "profile",
      "relationshipName": "patient",
      "relationshipSide": "right",
      "relationshipType": "one-to-one"
    },
    {
      "otherEntityName": "professional",
      "otherEntityRelationshipName": "profile",
      "relationshipName": "professional",
      "relationshipSide": "right",
      "relationshipType": "one-to-one"
    }
  ]
}
